with "config/ieee_ethernet_config.gpr";
--  Include the gpr file generated by Alire

project IEEE_Ethernet is

   for Languages use ("Ada");

   --  This project doesn't specify the Target or Runtime attributes
   --  because the project is intended to be architecture-independent.
   --  The two attributes' values are taken from the client projects
   --  (IEEE_Ethernet is never going to be a 'main' project).

   for Source_Dirs use ("src");

   Mode : IEEE_Ethernet_Config.Build_Profile_Kind :=
      external ("IEEE_Ethernet_Build_Mode", IEEE_Ethernet_Config.Build_Profile);

   for Object_Dir use "obj/" & Mode;
   for Create_Missing_Dirs use "True";

   Unconditional_Compiler_Switches :=
      ("-gnatwa",     -- turn on (almost) all warnings
       "-gnatwf",     -- warn on unreferenced formal parameters
       "-gnat2022",
       "-ffunction-sections",
       "-fdata-sections",
       "-gnatwJ");    -- don't warn on use of parens in aggregates!

   Debug_Switches := ("-g",
                      "-gnata",  -- enable all assertions
                      "-O0" -- NB: affects app task stacks (may need to be increased)
                      );

   Release_Switches := ("-O3",
                        "-gnatwe", -- treat warnings as errors
                        "-gnatn"   -- inter-unit inlining
                        );

   package Compiler is
      case Mode is
         when "release" =>
            for Switches ("ada") use Release_Switches & Unconditional_Compiler_Switches;
         when "validation" | "development" =>
            for Switches ("ada") use Debug_Switches & Unconditional_Compiler_Switches;
      end case;
   end Compiler;

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Clean is
      --  Enumerated rather than "*.*": with some gprclean versions the root
      --  project's pattern is applied to imported projects, and "*.*" then
      --  deletes the Alire-generated config projects.
      for Artifacts_In_Object_Dir use ("*.o", "*.ali", "*.json", "*.elf", "*.bin", "*.map", "map.txt");
   end Clean;

end IEEE_Ethernet;
