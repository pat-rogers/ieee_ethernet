--  Host-native test harness for the IEEE_Ethernet root package. The unit under
--  test is target-independent, so it compiles and runs unchanged on the
--  development machine.

project Test_IEEE_Ethernet is

   for Languages use ("Ada");

   for Source_Dirs use
     (".",
      "../../src");
   --  Only the closure of the main is built, so the PHY and SMI units sitting
   --  alongside ieee_ethernet.ads are never compiled here.

   for Object_Dir use "obj";

   for Main use ("test_ieee_ethernet.adb");

   package Compiler is
      for Switches ("ada") use
        ("-g",
         "-gnata",   -- enable all assertions
         "-gnatwa",  -- turn on (almost) all warnings
         "-gnatwJ",  -- don't warn about parens in aggregates
         "-gnatwC",  -- don't warn about conditions that are always tru
         "-gnat2022",
         "-O0");
   end Compiler;

   package Clean is
      for Artifacts_In_Object_Dir use ("*.*");
   end Clean;

end Test_IEEE_Ethernet;
